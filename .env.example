# ============================================================
# AnySport 体育数据 API 配置
# ============================================================
# 注册地址: https://dashboard.anysport.io/register
# 文档: https://docs.anysport.io/
# 控制台: https://dashboard.anysport.io/
#
# 免费试用: 120 calls/hour, 5 项基础能力 (实时比分/联赛/赛程/积分/H2H)
# Pro 套餐: $199/月, 10000 calls/hour, +赛前赔率
# Pro Max: $399/月, 20000 calls/hour, +实时赔率 + WebSocket
#
# 注册后从 dashboard 的 API Keys 页面获取 key
ANYSPORT_API_KEY=your_anysport_api_key_here


# ============================================================
# 天机道长 Chat (Tianji Bot) 配置
# ============================================================
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4-Flash